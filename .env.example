# Overrides for docker-compose.yml. Copy to `.env` next to it — compose reads that file
# automatically. `.env` is gitignored; never commit one.
#
#   cp .env.example .env
#
# Every line below is commented out and shows the built-in default, so an empty `.env` and no
# `.env` at all behave identically.

# ---- image -------------------------------------------------------------------------------
# Built locally by `just image` — there is no published image, so `docker compose pull` will
# not work and compose is configured never to try. `beadhive/core:dev` is the same image
# without the agent harness: the scheduler / HQ-sync shape.
#BH_IMAGE=beadhive/agent:dev

# Stable hostname, so bh's fleet roster keeps one label for this host across `down && up`
# instead of relabelling it with each new container ID.
#BH_HOSTNAME=beadhive

# The account the image runs as, which decides where the two home-relative volumes mount.
# This MIRRORS the image's AGENT_USER build arg and must match it — they are two halves of one
# decision, not two knobs:
#
#   just image                                       # default: AGENT_USER=bee
#   docker buildx bake agent \
#     --set '*.args.AGENT_USER=worker' \
#     --set '*.args.AGENT_UID=1501' \
#     --set '*.args.AGENT_GID=1501'                  # then set BH_AGENT_USER=worker here
#
# Override the image and forget this, and compose mounts volumes at /home/bee/... in an image
# that only has /home/worker/... — Docker creates those missing paths root-owned and the
# container is inert. (AGENT_UID/AGENT_GID have no compose counterpart: they only matter to
# the image and to bind-mount ownership, below.)
#BH_AGENT_USER=bee

# ---- volumes -----------------------------------------------------------------------------
# Each of the four areas is a named volume by default. Named volumes are chosen deliberately:
# `docker system df -v` then sizes each area for free, and the managed clones sit outside
# casual reach, where nobody can check out main in an internally-managed clone and dirty it.
#
#   bh-hq          ~/.beadhive       BH_HOME / BH_HQ      durable, git-backed
#   bh-workspace   /workspace        GIT_WORKSPACE        rebuildable managed clones
#   bh-worktrees   /worktrees        BH_WORKTREES         scratch, prunable, capped
#   bh-harness     ~/.claude         CLAUDE_CONFIG_DIR    durable, secret-bearing
#                                    CODEX_HOME           (~/.claude/codex — same volume)
#
# `~` is BH_AGENT_USER's home (default /home/bee) — see the knob above.
#
# Set any one to an ABSOLUTE host path (or a ./relative one) and compose reads it as a bind
# mount instead — same mount point, host-visible files. A bare word is read as a volume name,
# not a path, so `BH_HQ_MOUNT=data/hq` would silently create a volume called `data/hq`.
#
# Two caveats for bind mounts:
#   1. The container runs as the image's AGENT_UID/AGENT_GID (1000:1000 by default), and a
#      bind mount keeps its host ownership rather than taking the image's — so `chown` the
#      host directory to those ids first or the container cannot write to it. This is the case
#      AGENT_UID/AGENT_GID exist for: on a Linux host, bake them to match your own id instead
#      of chowning. Confirm with:
#        docker compose exec bh touch /worktrees/.probe
#      On a macOS Docker VM (colima, Docker Desktop) the share maps ownership on the way in
#      and a host `chown` may not reach it at all; a named volume is the better answer there.
#   2. bh-harness holds live credentials. Binding it to a host path puts those on the host
#      filesystem; on macOS it also does NOT carry Claude Code auth, which lives in the
#      Keychain — settings arrive, sign-in does not. That asymmetry is why the DEFAULT is an
#      empty named volume filled by a one-time in-container login, and bind-mounting the host
#      ~/.claude is an opt-in override rather than the happy path: a default that half-works
#      depending on the operator's OS is worse than one that always needs one explicit login.

# ---- harness auth ---------------------------------------------------------------------------
#
# INTERACTIVE HOST (default): leave both of these unset. Run the container, log in once inside
# it (`claude` / `codex`), and the credentials persist on the bh-harness volume across rebuilds.
#
# HEADLESS HOST (a VPS/factory node with no browser): set ONE of these instead.
#   CLAUDE_CODE_OAUTH_TOKEN — generate with `claude setup-token` on ANY machine that HAS a
#     browser, then paste it here. Preferred: it is the account's own credential, revocable,
#     and does not require an API-billing path.
#   ANTHROPIC_API_KEY — the fallback, where an API key is the intended billing route.
# They are passed THROUGH to the container, never baked into an image layer, so a token cannot
# leak via `docker history` or a pushed image.
#
#CLAUDE_CODE_OAUTH_TOKEN=
#ANTHROPIC_API_KEY=

# GitHub. gh reads GH_TOKEN (then GITHUB_TOKEN) and needs NO `gh auth login` at all — setting it
# takes precedence over any stored credential, which is why a headless factory host needs
# nothing else in order to clone and onboard.
#
# READ THIS BEFORE PICKING ONE — NOTHING BELOW AUTO-REFRESHES:
#
#   Personal access token (classic or fine-grained). Simplest. A FINE-GRAINED PAT EXPIRES, and
#     when it does the factory stops cloning with no warning and nothing self-heals. Choosing
#     this means owning the expiry date yourself.
#   `gh auth login` inside the container. Now durable — GH_CONFIG_DIR points into the bh-harness
#     volume, so gh's credentials survive a rebuild the way Claude's and Codex's already do. But
#     gh does NOT auto-renew: when a token lapses the documented remedy is `gh auth refresh`,
#     run by hand.
#   GitHub App installation token. The ONLY genuinely refreshable option — short-lived (~1h),
#     minted from the app's private key. It needs something to do the minting, which is real
#     infrastructure and is deliberately not built here. It is the right answer for a long-lived
#     unattended factory host.
#
# Passed THROUGH, never baked, so the token cannot leak via `docker history` or a pushed image.
#
#GH_TOKEN=
#
#BH_HQ_MOUNT=bh-hq
#BH_WORKSPACE_MOUNT=bh-workspace
#BH_WORKTREES_MOUNT=bh-worktrees
#BH_HARNESS_MOUNT=bh-harness

# ---- resource caps -----------------------------------------------------------------------
# FLOOR: Claude Code's documented system requirement is 4 GB+ RAM. Do not set BH_MEMORY below
#   4g — that is under the vendor's stated minimum, not merely slower.
# CEILING: the Docker VM is the real ceiling; a cap above its own allocation is theatre.
#   Read yours first:  docker info --format 'CPUs={{.NCPU}} Mem={{.MemTotal}}'
# On this host's 4 CPU / 6 GB colima VM (5.77 GiB usable) the two defaults sit differently:
# 4g is a REAL cap with ~1.7 GiB of VM left above it, while 4 CPUs is the whole VM and so is a
# share rather than a limit. Two agents still do not fit — 2 x 4 GiB against 5.77 GiB usable —
# so grow the VM before running a second node rather than shrinking the cap to make two "fit".
#BH_CPUS=4
#BH_MEMORY=4g

# Blast-radius guard against a runaway fork loop, not a tuning knob — it sits well above the
# low hundreds of tasks a dolt server plus a node harness actually use.
#BH_PIDS_LIMIT=1024

# ---- reserved --------------------------------------------------------------------------
# Nothing here for `ui` or `scheduler`: neither service exists, deliberately (bh-pc2a.9).
# `ui` is blocked on bh-xls2.6 deferring the self-host release and `scheduler` has no command
# in bh to run, so both are held open as the RESERVED SEAMS comment in docker-compose.yml
# rather than as config that would fail the moment someone enabled it.
