# Dolt sql-server config for the HQ server (bh-ijxif; ADR condition 15).
# HQ hosts HQ data only. NEVER co-host a hive database here: a global
# dolt_force_transaction_commit=1 would defeat FK epoch retirement for that hive.
#
# Run it with a READ-ONLY DOLT_ROOT_PATH (see docs/DOLT-SERVER-HARDENING.md and
# beadhive-dolt-hq.service.example) so SET PERSIST cannot stick.
log_level: info

listener:
  host: 0.0.0.0              # LAN only: bind the LAN address, not a public one
  port: 3306
  max_connections: 200       # watched: the HQ watched-globals.json expects 200
  require_secure_transport: true
  tls_cert: /etc/beadhive/dolt-hq/tls/server.crt
  tls_key: /etc/beadhive/dolt-hq/tls/server.key

data_dir: /var/lib/beadhive/dolt-hq/data   # HQ databases only
