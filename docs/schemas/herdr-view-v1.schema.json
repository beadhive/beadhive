{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beadhive.dev/schemas/herdr-view-v1.schema.json",
  "title": "Beadhive Herdr view projection v1",
  "oneOf": [
    { "$ref": "#/$defs/view" },
    { "$ref": "#/$defs/crew" },
    { "$ref": "#/$defs/streamFrame" }
  ],
  "$defs": {
    "sessionName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._-]+$"
    },
    "base": {
      "type": "object",
      "required": [
        "schema_version",
        "command",
        "view",
        "revision",
        "generated_at",
        "scope",
        "freshness",
        "coverage",
        "warnings"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "command": {
          "enum": [
            "plugin herdr view picker",
            "plugin herdr view deck",
            "plugin herdr view bead",
            "plugin herdr view agent",
            "plugin herdr view layout",
            "plugin herdr view presentation"
          ]
        },
        "view": { "enum": ["picker", "deck", "bead", "agent", "layout", "presentation"] },
        "revision": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "integer", "minimum": 0 },
        "scope": { "type": "object" },
        "freshness": { "type": "object" },
        "coverage": { "type": "object" },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "invoke": {
      "type": ["object", "null"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 5,
          "items": { "type": "string" },
          "prefixItems": [
            { "const": "bh" },
            { "const": "plugin" },
            { "const": "herdr" }
          ]
        },
        "input": { "enum": ["none", "parameters", "stdin"] },
        "shell": { "const": false }
      },
      "required": ["argv", "input", "shell"],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": [
        "id",
        "source_action",
        "label",
        "availability",
        "reason",
        "consequence",
        "preconditions",
        "input",
        "invoke"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source_action": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "maxLength": 120 },
        "availability": {
          "enum": ["allowed", "confirmation-required", "forbidden", "unavailable"]
        },
        "reason": { "type": "string", "maxLength": 240 },
        "invoke": { "$ref": "#/$defs/invoke" }
      }
    },
    "row": {
      "type": "object",
      "required": [
        "key",
        "primary",
        "secondary",
        "style",
        "glyph",
        "badges",
        "entity",
        "tokens",
        "primary_action",
        "actions"
      ],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "primary": { "type": "string", "maxLength": 160 },
        "secondary": { "type": "string", "maxLength": 200 },
        "style": { "type": "string" },
        "glyph": { "type": "string", "minLength": 1, "maxLength": 2 },
        "badges": { "type": "array", "items": { "type": "object" } },
        "entity": { "type": "object" },
        "tokens": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 160 }
        },
        "primary_action": { "type": ["string", "null"] },
        "actions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "deckSurface": {
      "type": "object",
      "required": [
        "placement",
        "direction",
        "target_role",
        "lifecycle",
        "close_behavior",
        "reopen_behavior",
        "focus",
        "variant",
        "section_mode",
        "columns",
        "inspector"
      ],
      "properties": {
        "placement": { "enum": ["split", "tab"] },
        "direction": { "type": ["string", "null"], "enum": ["right", "down", null] },
        "target_role": { "enum": ["agents", "board"] },
        "lifecycle": { "enum": ["ordinary-pane", "ordinary-tab"] },
        "close_behavior": { "const": "close" },
        "reopen_behavior": { "enum": ["reopen-split", "reopen-tab"] },
        "focus": { "type": "boolean" },
        "variant": { "enum": ["narrow", "medium", "wide"] },
        "section_mode": { "enum": ["single-list", "tabs", "columns"] },
        "columns": { "type": "integer", "minimum": 1 },
        "inspector": { "enum": ["overlay", "below"] }
      },
      "oneOf": [
        {
          "properties": {
            "placement": { "const": "split" },
            "direction": { "enum": ["right", "down"] },
            "target_role": { "const": "agents" },
            "lifecycle": { "const": "ordinary-pane" },
            "reopen_behavior": { "const": "reopen-split" }
          }
        },
        {
          "properties": {
            "placement": { "const": "tab" },
            "direction": { "type": "null" },
            "target_role": { "const": "board" },
            "lifecycle": { "const": "ordinary-tab" },
            "reopen_behavior": { "const": "reopen-tab" }
          }
        }
      ]
    },
    "layout": {
      "type": "object",
      "required": ["session", "cross_session_focus", "tabs", "surfaces", "viewport"],
      "properties": {
        "session": { "$ref": "#/$defs/sessionName" },
        "cross_session_focus": { "const": false },
        "tabs": { "type": "array", "items": { "type": "object" } },
        "surfaces": {
          "type": "object",
          "required": ["picker", "deck", "agent_actions", "activity_tray"],
          "properties": {
            "picker": { "type": "object" },
            "deck": { "$ref": "#/$defs/deckSurface" },
            "agent_actions": { "type": "object" },
            "activity_tray": { "type": "object" }
          }
        },
        "viewport": { "type": "object" }
      }
    },
    "crewLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session", "workspace_id", "tab_id", "pane_id", "target"],
      "properties": {
        "session": { "$ref": "#/$defs/sessionName" },
        "workspace_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "tab_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "pane_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "target": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "crewNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target", "relation", "bead", "harness", "role", "work", "topology",
        "safe_actions", "children"
      ],
      "properties": {
        "target": { "type": "string", "minLength": 1, "maxLength": 256 },
        "relation": {
          "enum": [
            "root-dispatcher", "direct-agent", "direct-child",
            "direct-child-dispatcher", "orphan"
          ]
        },
        "bead": { "type": ["string", "null"], "maxLength": 256 },
        "harness": { "type": "string", "maxLength": 80 },
        "role": { "enum": ["developer", "dispatcher", "unknown"] },
        "work": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "phase"],
          "properties": {
            "operation": { "type": "string", "maxLength": 80 },
            "phase": { "type": "string", "maxLength": 40 }
          }
        },
        "topology": {
          "type": "object",
          "additionalProperties": false,
          "required": ["coverage", "direct_active_children", "total_active_descendants"],
          "properties": {
            "coverage": { "enum": ["complete", "partial", "unavailable"] },
            "direct_active_children": { "type": ["integer", "null"], "minimum": 0 },
            "total_active_descendants": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "safe_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["focus", "attach"] }
        },
        "locator": { "$ref": "#/$defs/crewLocator" },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role"],
          "properties": { "role": { "enum": ["dispatcher", "direct-agent"] } }
        },
        "stage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["desired", "placement", "role"],
          "properties": {
            "desired": { "const": true },
            "placement": { "const": "right" },
            "role": { "const": "child-stage" }
          }
        },
        "safe_removal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "reason_code", "source_revision"],
          "properties": {
            "availability": { "const": "confirmation-required" },
            "reason_code": { "const": "operator-confirmation-required" },
            "source_revision": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        },
        "children": { "type": "array", "items": { "$ref": "#/$defs/crewNode" } }
      }
    },
    "crew": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "command", "view", "revision", "source_revision", "generated_at",
        "hive_id", "scope", "freshness", "coverage", "workspace", "roots", "returned",
        "limit", "truncated", "next_cursor", "diagnostics", "warnings"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "command": { "const": "plugin herdr view crew" },
        "view": { "const": "crew" },
        "revision": { "type": "string", "minLength": 1 },
        "source_revision": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "integer", "minimum": 0 },
        "hive_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hive", "session"],
          "properties": {
            "hive": { "type": "string", "minLength": 1, "maxLength": 256 },
            "session": { "$ref": "#/$defs/sessionName" }
          }
        },
        "freshness": { "type": "object" },
        "coverage": { "type": "object" },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["locator", "role", "desired_tabs"],
          "properties": {
            "locator": {
              "type": "object",
              "additionalProperties": false,
              "required": ["session", "workspace_id"],
              "properties": {
                "session": { "$ref": "#/$defs/sessionName" },
                "workspace_id": { "type": ["string", "null"], "maxLength": 256 }
              }
            },
            "role": { "const": "hive" },
            "desired_tabs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["role", "label"],
                "properties": {
                  "role": { "enum": ["crew", "dispatcher", "direct-agent"] },
                  "target": { "type": "string", "minLength": 1, "maxLength": 256 },
                  "label": { "type": "string", "minLength": 1, "maxLength": 80 }
                }
              }
            }
          }
        },
        "roots": { "type": "array", "items": { "$ref": "#/$defs/crewNode" } },
        "returned": { "type": "integer", "minimum": 0, "maximum": 200 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
        "truncated": { "type": "boolean" },
        "next_cursor": { "type": "null" },
        "diagnostics": {
          "type": "array", "maxItems": 256, "items": { "type": "object" }
        },
        "warnings": { "type": "array", "maxItems": 200, "items": { "type": "string" } }
      }
    },
    "view": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
            "row": { "$ref": "#/$defs/row" },
            "sections": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "label", "rows"],
                "properties": {
                  "id": { "type": "string" },
                  "label": { "type": "string" },
                  "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } }
                }
              }
            },
            "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
            "layout": { "$ref": "#/$defs/layout" },
            "surface": { "type": "object" },
            "detail": { "type": "object" },
            "next_cursor": { "type": ["string", "null"] },
            "truncated": { "type": "boolean" },
            "returned": { "type": "integer", "minimum": 0 },
            "limit": { "type": "integer", "minimum": 1, "maximum": 200 }
          }
        }
      ]
    },
    "streamFrame": {
      "type": "object",
      "required": ["schema_version", "command", "type"],
      "properties": {
        "schema_version": { "const": 1 },
        "command": { "const": "plugin herdr view stream" },
        "type": { "enum": ["snapshot", "agent-observed", "error"] },
        "sequence": { "type": "integer", "minimum": 0 },
        "cursor": { "type": "string", "minLength": 1 },
        "resync_required": { "type": "boolean" },
        "resync_reason": { "type": ["string", "null"] },
        "snapshot": { "$ref": "#/$defs/view" },
        "entity": { "type": "object" },
        "error": { "type": "object" }
      }
    }
  }
}
