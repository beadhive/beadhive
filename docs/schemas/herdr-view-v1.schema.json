{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beadhive.dev/schemas/herdr-view-v1.schema.json",
  "title": "Beadhive Herdr view projection v1",
  "oneOf": [
    { "$ref": "#/$defs/view" },
    { "$ref": "#/$defs/streamFrame" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": [
        "schema_version",
        "command",
        "view",
        "revision",
        "generated_at",
        "scope",
        "freshness",
        "coverage",
        "warnings"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "command": {
          "enum": [
            "plugin herdr view picker",
            "plugin herdr view deck",
            "plugin herdr view bead",
            "plugin herdr view agent",
            "plugin herdr view layout",
            "plugin herdr view presentation"
          ]
        },
        "view": { "enum": ["picker", "deck", "bead", "agent", "layout", "presentation"] },
        "revision": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "integer", "minimum": 0 },
        "scope": { "type": "object" },
        "freshness": { "type": "object" },
        "coverage": { "type": "object" },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "invoke": {
      "type": ["object", "null"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 5,
          "items": { "type": "string" },
          "prefixItems": [
            { "const": "bh" },
            { "const": "plugin" },
            { "const": "herdr" }
          ]
        },
        "input": { "enum": ["none", "parameters", "stdin"] },
        "shell": { "const": false }
      },
      "required": ["argv", "input", "shell"],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": [
        "id",
        "source_action",
        "label",
        "availability",
        "reason",
        "consequence",
        "preconditions",
        "input",
        "invoke"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source_action": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "maxLength": 120 },
        "availability": {
          "enum": ["allowed", "confirmation-required", "forbidden", "unavailable"]
        },
        "reason": { "type": "string", "maxLength": 240 },
        "invoke": { "$ref": "#/$defs/invoke" }
      }
    },
    "row": {
      "type": "object",
      "required": [
        "key",
        "primary",
        "secondary",
        "style",
        "glyph",
        "badges",
        "entity",
        "tokens",
        "primary_action",
        "actions"
      ],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "primary": { "type": "string", "maxLength": 160 },
        "secondary": { "type": "string", "maxLength": 200 },
        "style": { "type": "string" },
        "glyph": { "type": "string", "minLength": 1, "maxLength": 2 },
        "badges": { "type": "array", "items": { "type": "object" } },
        "entity": { "type": "object" },
        "tokens": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 160 }
        },
        "primary_action": { "type": ["string", "null"] },
        "actions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "deckSurface": {
      "type": "object",
      "required": [
        "placement",
        "direction",
        "target_role",
        "lifecycle",
        "close_behavior",
        "reopen_behavior",
        "focus",
        "variant",
        "section_mode",
        "columns",
        "inspector"
      ],
      "properties": {
        "placement": { "enum": ["split", "tab"] },
        "direction": { "type": ["string", "null"], "enum": ["right", "down", null] },
        "target_role": { "enum": ["agents", "board"] },
        "lifecycle": { "enum": ["ordinary-pane", "ordinary-tab"] },
        "close_behavior": { "const": "close" },
        "reopen_behavior": { "enum": ["reopen-split", "reopen-tab"] },
        "focus": { "type": "boolean" },
        "variant": { "enum": ["narrow", "medium", "wide"] },
        "section_mode": { "enum": ["single-list", "tabs", "columns"] },
        "columns": { "type": "integer", "minimum": 1 },
        "inspector": { "enum": ["overlay", "below"] }
      },
      "oneOf": [
        {
          "properties": {
            "placement": { "const": "split" },
            "direction": { "enum": ["right", "down"] },
            "target_role": { "const": "agents" },
            "lifecycle": { "const": "ordinary-pane" },
            "reopen_behavior": { "const": "reopen-split" }
          }
        },
        {
          "properties": {
            "placement": { "const": "tab" },
            "direction": { "type": "null" },
            "target_role": { "const": "board" },
            "lifecycle": { "const": "ordinary-tab" },
            "reopen_behavior": { "const": "reopen-tab" }
          }
        }
      ]
    },
    "layout": {
      "type": "object",
      "required": ["session", "cross_session_focus", "tabs", "surfaces", "viewport"],
      "properties": {
        "session": { "const": "bh-supervisor" },
        "cross_session_focus": { "const": false },
        "tabs": { "type": "array", "items": { "type": "object" } },
        "surfaces": {
          "type": "object",
          "required": ["picker", "deck", "agent_actions", "activity_tray"],
          "properties": {
            "picker": { "type": "object" },
            "deck": { "$ref": "#/$defs/deckSurface" },
            "agent_actions": { "type": "object" },
            "activity_tray": { "type": "object" }
          }
        },
        "viewport": { "type": "object" }
      }
    },
    "view": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
            "row": { "$ref": "#/$defs/row" },
            "sections": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "label", "rows"],
                "properties": {
                  "id": { "type": "string" },
                  "label": { "type": "string" },
                  "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } }
                }
              }
            },
            "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
            "layout": { "$ref": "#/$defs/layout" },
            "surface": { "type": "object" },
            "detail": { "type": "object" },
            "next_cursor": { "type": ["string", "null"] },
            "truncated": { "type": "boolean" },
            "returned": { "type": "integer", "minimum": 0 },
            "limit": { "type": "integer", "minimum": 1, "maximum": 200 }
          }
        }
      ]
    },
    "streamFrame": {
      "type": "object",
      "required": ["schema_version", "command", "type"],
      "properties": {
        "schema_version": { "const": 1 },
        "command": { "const": "plugin herdr view stream" },
        "type": { "enum": ["snapshot", "agent-observed", "error"] },
        "sequence": { "type": "integer", "minimum": 0 },
        "cursor": { "type": "string", "minLength": 1 },
        "resync_required": { "type": "boolean" },
        "resync_reason": { "type": ["string", "null"] },
        "snapshot": { "$ref": "#/$defs/view" },
        "entity": { "type": "object" },
        "error": { "type": "object" }
      }
    }
  }
}
