{
  "$defs": {
    "Harness": {
      "enum": [
        "codex",
        "claude",
        "opencode"
      ],
      "title": "Harness",
      "type": "string"
    }
  },
  "$id": "urn:beadhive:wire-schema:agent-launch-receipt:1",
  "additionalProperties": false,
  "description": "Portable, redacted facts proving one resolved core launch.\n\nThe discriminator is deliberately namespaced so extension consumers can route a\nreceipt before validation.  Core consumers accept only this exact base shape: an\nextension must explicitly project its ``core`` member instead of relying on extra\nfields being ignored.",
  "properties": {
    "available_seats": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Available Seats",
      "type": "array",
      "uniqueItems": true
    },
    "bead": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9-]*-[a-z0-9]+(?:\\.[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bead"
    },
    "current_seat": {
      "minLength": 1,
      "title": "Current Seat",
      "type": "string"
    },
    "effort": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effort"
    },
    "harness": {
      "$ref": "#/$defs/Harness"
    },
    "initial_seat": {
      "minLength": 1,
      "title": "Initial Seat",
      "type": "string"
    },
    "managed_bead": {
      "title": "Managed Bead",
      "type": "boolean"
    },
    "model": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "receipt_type": {
      "const": "beadhive.agent-launch",
      "default": "beadhive.agent-launch",
      "title": "Receipt Type",
      "type": "string"
    },
    "seat_contract_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Seat Contract Digest",
      "type": "string"
    },
    "seat_contract_version": {
      "minLength": 1,
      "title": "Seat Contract Version",
      "type": "string"
    },
    "version": {
      "const": "1",
      "default": "1",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "managed_bead",
    "initial_seat",
    "current_seat",
    "available_seats",
    "harness",
    "seat_contract_version",
    "seat_contract_digest"
  ],
  "title": "AgentLaunchReceipt",
  "type": "object",
  "version": 1
}
