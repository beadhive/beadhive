{
  "openapi": "3.1.0",
  "info": {
    "title": "Beadhive Host Operator API",
    "version": "1.1.0",
    "description": "Phase 1 is an unauthenticated, loopback-only, read-only GET profile. A later non-loopback profile applies the documented bearer scheme without changing these source payloads."
  },
  "security": [],
  "x-beadhive-phase": "local-read-only-v1",
  "x-beadhive-authentication-profile": {
    "phase1": "none; literal loopback listener plus exact Host and Origin checks",
    "later": "BearerAuth with operator:read"
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Minimal daemon liveness",
        "responses": {
          "200": {
            "description": "Minimal liveness and readiness only",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Health"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "405": {"$ref": "#/components/responses/ReadOnly"}
        }
      }
    },
    "/api/v1/factory": {
      "get": {
        "operationId": "operatorFactory",
        "summary": "Read the authoritative registered hive directory",
        "description": "Returns a flat FactorySnapshot v1-compatible object. Phase 1 does not expose workspace or worktree paths and reports omitted topology through coverage.",
        "responses": {
          "200": {
            "description": "Current factory directory and daemon status",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/FactorySnapshot"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "405": {"$ref": "#/components/responses/ReadOnly"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/api/v1/factory/hives": {
      "get": {
        "operationId": "operatorFactoryHives",
        "summary": "Read bounded generic summaries for registered hives",
        "description": "Returns canonical registry identity and source-derived aggregate counts. Ordering is lexical by canonical hive id. An unavailable hive remains present with null counts; an available empty hive has zero counts. open counts literal status=open records; ready is the subset with no known unresolved prerequisite or open gate; active counts status=in_progress; blocked combines status=blocked with open issues that have a known unresolved prerequisite. ready and blocked are subsets that may overlap the open category.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {"type": "integer", "minimum": 1, "maximum": 200, "default": 50}
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque snapshot-scoped cursor returned by nextCursor.",
            "schema": {"type": "string", "minLength": 1}
          },
          {
            "name": "availability",
            "in": "query",
            "required": false,
            "schema": {"enum": ["available", "unavailable"]}
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "required": false,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "One bounded deterministic page of hive summaries",
            "headers": {"ETag": {"schema": {"type": "string"}}},
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FactoryHivePage"}}}
          },
          "304": {"description": "The selected page still matches If-None-Match"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "405": {"$ref": "#/components/responses/ReadOnly"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/api/v1/hives/{hive_id}/snapshot": {
      "get": {
        "operationId": "operatorHiveSnapshot",
        "summary": "Read one exact canonical hive snapshot",
        "description": "The provider/organization/repository identity uses one uppercase percent-encoded representation; slash separators are %2F. The returned snapshot and cursor are installed atomically.",
        "parameters": [
          {
            "name": "hive_id",
            "in": "path",
            "required": true,
            "description": "Full canonical provider/organization/repository identity, with separators encoded as uppercase %2F.",
            "schema": {"type": "string", "pattern": "^[A-Za-z0-9._~-]+%2F[A-Za-z0-9._~-]+%2F[A-Za-z0-9._~-]+$"}
          }
        ],
        "responses": {
          "200": {
            "description": "Direct HiveOperatorSnapshot",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/HiveOperatorSnapshot"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "405": {"$ref": "#/components/responses/ReadOnly"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/api/v1/hives/{hive_id}/events": {
      "get": {
        "operationId": "operatorHiveEvents",
        "summary": "Follow one exact canonical hive event stream",
        "description": "Returns only operator-event SSE frames strictly after the supplied snapshot cursor. after is normative; cursor is a temporary compatibility alias. If multiple cursor sources are present, their values must be byte-identical.",
        "parameters": [
          {
            "name": "hive_id",
            "in": "path",
            "required": true,
            "description": "Full canonical provider/organization/repository identity, with separators encoded as uppercase %2F.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._~-]+%2F[A-Za-z0-9._~-]+%2F[A-Za-z0-9._~-]+$"
            }
          },
          {
            "name": "subscription",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "description": "Normative snapshot or SSE cursor producerEpoch:sequence.",
            "schema": {
              "$ref": "#/components/schemas/EventCursorString"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "deprecated": true,
            "description": "Temporary compatibility alias for after.",
            "schema": {
              "$ref": "#/components/schemas/EventCursorString"
            }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/EventCursorString"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authoritative OperatorEvent stream",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Accel-Buffering": {
                "schema": {
                  "const": "no"
                }
              }
            },
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorEvent"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/ReadOnly"
          },
          "409": {
            "$ref": "#/components/responses/Resnapshot"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "options": {
        "operationId": "operatorHiveEventsPreflight",
        "summary": "Authorize the exact local Last-Event-ID SSE preflight",
        "parameters": [
          {
            "name": "hive_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._~-]+%2F[A-Za-z0-9._~-]+%2F[A-Za-z0-9._~-]+$"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The exact allowed Origin may issue GET with Last-Event-ID",
            "headers": {
              "Access-Control-Allow-Origin": {
                "schema": {
                  "type": "string"
                }
              },
              "Access-Control-Allow-Methods": {
                "schema": {
                  "const": "GET"
                }
              },
              "Access-Control-Allow-Headers": {
                "schema": {
                  "const": "Last-Event-ID"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/runs/{run_id}/activity": {
      "get": {
        "operationId": "operatorRunActivity",
        "summary": "Read activity for one exact outer run",
        "description": "The activity producer epoch and sequence are independent of the journal source revision. A missing source is never returned as authoritative empty activity.",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "minLength": 1, "maxLength": 256}
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "description": "Return a delta strictly after producerEpoch:sequence.",
            "schema": {"type": "string", "pattern": "^[A-Za-z0-9._~-]+:(0|[1-9][0-9]*)$"}
          }
        ],
        "responses": {
          "200": {
            "description": "Direct RunActivityFrame snapshot or delta",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/RunActivityFrame"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "405": {"$ref": "#/components/responses/ReadOnly"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "410": {
            "description": "The cursor producer epoch is no longer retained",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "operatorOpenapi",
        "summary": "Read this checked non-MCP contract",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": {"application/json": {"schema": {"type": "object"}}}
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "405": {"$ref": "#/components/responses/ReadOnly"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "description": "Reserved for the later authenticated operator:read profile; not required or accepted by phase 1."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Unsafe identity, encoding, or cursor",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
      },
      "NotFound": {
        "description": "Exact hive, run, or source does not exist",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
      },
      "Forbidden": {
        "description": "The client peer or Origin is outside the local phase-one profile",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
      },
      "ReadOnly": {
        "description": "Only GET is exposed by the phase-one profile",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
      },
      "Conflict": {
        "description": "Ambiguous or mismatched authoritative identity",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
      },
      "Resnapshot": {
        "description": "The client must fetch a replacement hive snapshot before reconnecting",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Resnapshot"
            }
          }
        }
      },
      "Unavailable": {
        "description": "An authoritative local source could not answer",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "retryable"],
            "additionalProperties": false,
            "properties": {
              "code": {"type": "string"},
              "message": {"type": "string"},
              "retryable": {"type": "boolean"}
            }
          }
        }
      },
      "Resnapshot": {
        "type": "object",
        "required": [
          "error",
          "action"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string"
          },
          "action": {
            "const": "resnapshot"
          }
        }
      },
      "EventCursorString": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._~-]+:(0|[1-9][0-9]*)$"
      },
      "EntityRef": {
        "type": "object",
        "required": [
          "hiveId",
          "kind",
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "hiveId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "OperatorEvent": {
        "type": "object",
        "required": [
          "schemaVersion",
          "hiveId",
          "subscriptionId",
          "producerEpoch",
          "sequence",
          "baseSequence",
          "observedAt",
          "generatedAt",
          "source",
          "revision",
          "entity",
          "payload"
        ],
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "hiveId": {
            "type": "string",
            "minLength": 1
          },
          "subscriptionId": {
            "type": "string",
            "minLength": 1
          },
          "producerEpoch": {
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "baseSequence": {
            "type": "integer",
            "minimum": 0
          },
          "observedAt": {
            "type": "integer",
            "minimum": 0
          },
          "generatedAt": {
            "type": "integer",
            "minimum": 0
          },
          "source": {
            "enum": [
              "beads",
              "runtime",
              "supervisor"
            ]
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "entity": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/EntityRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "payload": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/EntityUpsert"
              },
              {
                "$ref": "#/components/schemas/EntityRemove"
              },
              {
                "$ref": "#/components/schemas/Invalidate"
              },
              {
                "$ref": "#/components/schemas/Reset"
              },
              {
                "$ref": "#/components/schemas/Heartbeat"
              }
            ]
          }
        }
      },
      "EntityUpsert": {
        "type": "object",
        "required": [
          "kind",
          "entity"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "entity-upsert"
          },
          "entity": {
            "type": "object",
            "required": [
              "ref"
            ]
          }
        }
      },
      "EntityRemove": {
        "type": "object",
        "required": [
          "kind",
          "entity",
          "revision"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "entity-remove"
          },
          "entity": {
            "$ref": "#/components/schemas/EntityRef"
          },
          "revision": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Invalidate": {
        "type": "object",
        "required": [
          "kind",
          "scopes",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "invalidate"
          },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Reset": {
        "type": "object",
        "required": [
          "kind",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "reset"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Heartbeat": {
        "type": "object",
        "required": [
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "heartbeat"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": ["live", "ready", "contract"],
        "additionalProperties": false,
        "properties": {
          "live": {"const": true},
          "ready": {"type": "boolean"},
          "contract": {"type": "string"}
        }
      },
      "SourceCoverage": {
        "type": "object",
        "required": ["state", "requested", "returned", "fromCache", "detail"],
        "properties": {
          "state": {"enum": ["complete", "partial", "unavailable"]},
          "requested": {"type": ["integer", "null"]},
          "returned": {"type": ["integer", "null"]},
          "fromCache": {"type": "integer", "minimum": 0},
          "detail": {"type": ["string", "null"]}
        }
      },
      "HiveInfo": {
        "type": "object",
        "required": ["prefix", "provider", "org", "repo", "kind"],
        "properties": {
          "prefix": {"type": "string"},
          "provider": {"type": "string"},
          "org": {"type": "string"},
          "repo": {"type": "string"},
          "kind": {"type": "string"}
        }
      },
      "FactorySnapshot": {
        "type": "object",
        "required": ["schemaVersion", "hives", "worktrees", "edges", "workspaceRoot", "generatedAt", "coverage"],
        "properties": {
          "schemaVersion": {"const": 1},
          "hives": {"type": "array", "items": {"$ref": "#/components/schemas/HiveInfo"}},
          "worktrees": {"type": "array", "maxItems": 0},
          "edges": {"type": "array", "maxItems": 0},
          "workspaceRoot": {"type": "null"},
          "generatedAt": {"type": "integer", "minimum": 0},
          "coverage": {
            "type": "object",
            "required": ["hives", "worktrees", "hubIssues", "hubDeps"],
            "properties": {
              "hives": {"$ref": "#/components/schemas/SourceCoverage"},
              "worktrees": {"$ref": "#/components/schemas/SourceCoverage"},
              "hubIssues": {"$ref": "#/components/schemas/SourceCoverage"},
              "hubDeps": {"$ref": "#/components/schemas/SourceCoverage"}
            }
          },
          "hostId": {"type": "string"},
          "serviceInstanceId": {"type": "string"},
          "ready": {"type": "boolean"}
        }
      },
      "FactoryHiveSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayLabel", "opaqueRef", "prefix", "provider", "org", "repo", "kind", "availability", "counts", "revision", "asOf", "coverage"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+$"},
          "displayLabel": {"type": "string", "minLength": 1},
          "opaqueRef": {"type": "string", "pattern": "^hive-sha256-[a-f0-9]{64}$"},
          "prefix": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "org": {"type": "string", "minLength": 1},
          "repo": {"type": "string", "minLength": 1},
          "kind": {"type": "string"},
          "availability": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "reason"],
            "properties": {
              "state": {"enum": ["available", "unavailable"]},
              "reason": {"type": ["string", "null"]}
            }
          },
          "counts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["open", "ready", "active", "blocked"],
            "properties": {
              "open": {"type": ["integer", "null"], "minimum": 0},
              "ready": {"type": ["integer", "null"], "minimum": 0},
              "active": {"type": ["integer", "null"], "minimum": 0},
              "blocked": {"type": ["integer", "null"], "minimum": 0}
            }
          },
          "revision": {"type": ["string", "null"]},
          "asOf": {"type": ["integer", "null"], "minimum": 0},
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "reason"],
            "properties": {
              "state": {"enum": ["complete", "partial", "unavailable"]},
              "reason": {"type": ["string", "null"]}
            }
          }
        }
      },
      "FactoryHivePage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "revision", "generatedAt", "items", "returnedCount", "limit", "truncated", "nextCursor", "warnings"],
        "properties": {
          "schemaVersion": {"const": 1},
          "revision": {"type": "string", "minLength": 1},
          "generatedAt": {"type": "integer", "minimum": 0},
          "items": {"type": "array", "maxItems": 200, "items": {"$ref": "#/components/schemas/FactoryHiveSummary"}},
          "returnedCount": {"type": "integer", "minimum": 0, "maximum": 200},
          "limit": {"type": "integer", "minimum": 1, "maximum": 200},
          "truncated": {"type": "boolean"},
          "nextCursor": {"type": ["string", "null"]},
          "warnings": {"type": "array", "items": {"type": "string"}}
        }
      },
      "StreamCursor": {
        "type": "object",
        "required": ["subscriptionId", "producerEpoch", "sequence", "observedAt"],
        "properties": {
          "subscriptionId": {"type": "string"},
          "producerEpoch": {"type": "string"},
          "sequence": {"type": "integer", "minimum": 0},
          "observedAt": {"type": "integer", "minimum": 0}
        }
      },
      "HiveOperatorSnapshot": {
        "type": "object",
        "required": ["schemaVersion", "hive", "revision", "generatedAt", "cursor", "coverage", "workItems", "dependencies", "epics", "gates", "agents", "assignments", "schedules", "evidence", "advertisedActions"],
        "properties": {
          "schemaVersion": {"const": 1},
          "hive": {"$ref": "#/components/schemas/HiveInfo"},
          "revision": {"type": "string", "minLength": 1},
          "generatedAt": {"type": "integer", "minimum": 0},
          "cursor": {"$ref": "#/components/schemas/StreamCursor"},
          "coverage": {"type": "object"},
          "workItems": {"type": "array", "items": {"type": "object"}},
          "dependencies": {"type": "array", "items": {"type": "object"}},
          "epics": {"type": "array", "items": {"type": "object"}},
          "gates": {"type": "array", "items": {"type": "object"}},
          "agents": {"type": "array", "items": {"type": "object"}},
          "assignments": {"type": "array", "items": {"type": "object"}},
          "schedules": {"type": "array", "items": {"type": "object"}},
          "evidence": {"type": "array", "items": {"type": "object"}},
          "advertisedActions": {"type": "array", "items": {"type": "object"}}
        }
      },
      "RunActivityEnvelope": {
        "type": "object",
